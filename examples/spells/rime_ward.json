{
  "name": "Rime Ward",
  "description": "A shell of rime grants you 5 temporary hit points. While any of them remain, a creature that hits you with an attack takes 5 cold damage; the ward breaks when they are gone.",
  "type": "spell",
  "spell_level": 1,
  "spell_range": {
    "type": "self"
  },
  "targeting_type": "single_target",
  "casting_time": {
    "type": "action",
    "count": 1
  },
  "duration": {
    "unit": "hour",
    "count": 1,
    "concentration": false
  },
  "components": {
    "verbal": true,
    "somatic": true,
    "material": []
  },
  "program": [
    {
      "block": "lifetime",
      "kind": "rounds",
      "source": "rime_ward",
      "then": [
        {
          "block": "grant_temporary_hp",
          "target": "current",
          "amount": 5
        },
        {
          "block": "trigger",
          "event": "ATTACK_HIT",
          "holder": "defender",
          "rebind_target": "event.attacker",
          "when": "event.defender == entity",
          "then": [
            {
              "block": "damage",
              "damage_type": "COLD",
              "formula": "5",
              "condition": "entity.temporary_hp > 0"
            }
          ]
        },
        {
          "block": "trigger",
          "event": "DAMAGE_DEALT",
          "holder": "defender",
          "when": "event.defender == entity",
          "then": [
            {
              "block": "end_lifetime",
              "condition": "entity.temporary_hp <= 0"
            }
          ]
        }
      ]
    }
  ],
  "animation": [
    [{"type": "aura", "color": "#88CCFF", "at": "caster", "duration": 1.2, "size": 1.6, "pulses": 3}],
    [{"type": "particles", "color": "#AADDFF", "at": "caster", "count": 15, "spread": 5, "duration": 0.6, "speed": 0.8}]
  ]
}
